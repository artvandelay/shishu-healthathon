{# Context from `intake/reports.py`: lang, css, doc_title, pdf_subject, logo_uri, call_id, who, meta,
   emergency, incomplete, yes_items, observations, observations_heading,
   page2_groups, page2_unknown, page2_unanswered, page2_unasked.
   Strictly factual: this sheet repeats what was said on the call. No advice, no directives, no questions.
   Page one is the "yes" list; page two is the full detail list with its response key.
   Identical context contract to every pack — `intake/reports.py` renders this with no pack-specific code. #}
{%- set lang = lang|default('hi') -%}
{%- set hi = lang != 'en' -%}
{%- set no_answer = 'नहीं' if hi else 'No' -%}
{%- macro detail_group(group, answer) -%}
{%- set title = group["title"] if group is mapping else group.title -%}
{%- set items = group["items"] if group is mapping else group.items -%}
  <div class="group">{{ title|e }}</div>
{% for item in items %}
{%- set question = item["question"] if item is mapping else item -%}
{%- set ans = item["answer"] if (item is mapping and item.get("answer")) else answer -%}
  <div class="no-row"><span>{{ question|e }}</span><span class="ans">{{ ans|e }}</span></div>
{% endfor %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ lang|e }}">
<head><meta charset="utf-8"><title>{{ doc_title|e }}</title><meta name="description" content="{{ pdf_subject|e }}"><style>{{ css }}</style></head>
<body>
<header>
  <div class="top">
    <img src="{{ logo_uri }}" alt="">
    <div class="brand">SHISHU OPD</div>
    <div class="kind">{{ 'कॉल रिपोर्ट' if hi else 'Call Record' }}</div>
  </div>
  <div class="rule"></div>
  <p class="who">{{ who|e }}</p>
  <p class="meta">{{ meta|e }}</p>
</header>
<div class="notice">{{ 'यह इस कॉल में बताई गई बातों का रिकॉर्ड है, कोई बीमारी की पुष्टि (डायग्नोसिस) नहीं।' if hi else 'This is a record of what was shared on this call, not a medical diagnosis.' }}</div>
{% if emergency %}
<div class="band">{{ '<b>इस कॉल में इमरजेंसी की बात दर्ज हुई।</b><br>अभी नज़दीकी अस्पताल जाइए, या 108 पर कॉल कीजिए।' if hi else '<b>An emergency was reported during this call.</b><br>Go to the nearest hospital right now, or call 108.' }}</div>
{% elif incomplete %}
<div class="band">{{ '<b>यह कॉल अधूरी रही।</b> नीचे वही है जो इस कॉल में पूछा जा सका।' if hi else '<b>This call ended before all questions were asked.</b> Below is what was recorded.' }}</div>
{% endif %}
<h1>{{ 'इस कॉल में जो हाँ दर्ज हुआ' if hi else 'Reported "Yes" on this call' }}</h1>
{% if yes_items %}
<ul class="yes">{% for line in yes_items %}<li>{{ line|e }}</li>{% endfor %}</ul>
{% elif page2_unasked and not page2_groups and not page2_unknown and not page2_unanswered %}
<p class="calm">{{ 'इस कॉल में कोई जवाब दर्ज नहीं हुआ।' if hi else 'No answers were recorded on this call.' }}</p>
{% else %}
<p class="calm">{{ 'इस कॉल में कोई बात हाँ में दर्ज नहीं हुई।' if hi else 'No "Yes" items were recorded on this call.' }}</p>
{% endif %}
<section class="page2">
  <h1>{{ 'विवरण' if hi else 'Details' }}</h1>
  <p class="meta">{{ who|e }}</p>
{% if observations %}
  <div class="group">{{ observations_heading|e }}</div>
  <ul class="notes">{% for line in observations %}<li>{{ line|e }}</li>{% endfor %}</ul>
{% endif %}
  <div class="group">{{ 'जवाब का मतलब' if hi else 'Response key' }}</div>
  <div class="no-row"><span>{{ 'हाँ' if hi else 'Yes' }}</span><span class="ans">{{ 'दर्ज की गई बात' if hi else 'Reported on call' }}</span></div>
  <div class="no-row"><span>{{ 'नहीं' if hi else 'No' }}</span><span class="ans">{{ 'साफ़ इनकार' if hi else 'Confirmed no' }}</span></div>
  <div class="no-row"><span>{{ 'पता नहीं' if hi else "Don't know" }}</span><span class="ans">{{ 'खुद कहा — पता नहीं, या जाँच नहीं हुई' if hi else "Caller said don't know / not tested" }}</span></div>
  <div class="no-row"><span>{{ 'जवाब नहीं हो पाया' if hi else 'Not answered' }}</span><span class="ans">{{ 'कॉल पर जवाब नहीं मिला' if hi else 'No answer recorded on call' }}</span></div>
{% for group in page2_groups %}{{ detail_group(group, no_answer) }}{% endfor %}
{% if page2_unknown %}
  <div class="group">{{ 'पक्का जवाब नहीं मिला' if hi else "Don't know" }}</div>
{% for question in page2_unknown %}
  <div class="no-row"><span>{{ question|e }}</span><span class="ans">{{ 'पता नहीं' if hi else "Don't know" }}</span></div>
{% endfor %}
{% endif %}
{% if page2_unanswered %}
  <div class="group">{{ 'कॉल पर जवाब नहीं मिला' if hi else 'Not answered' }}</div>
{% for question in page2_unanswered %}
  <div class="no-row"><span>{{ question|e }}</span><span class="ans">{{ 'जवाब नहीं हो पाया' if hi else 'Not answered' }}</span></div>
{% endfor %}
{% endif %}
{% if page2_unasked %}
  <div class="group">{{ 'अभी नहीं पूछा गया' if hi else 'Not asked' }}</div>
{% for group in page2_unasked %}{{ detail_group(group, 'पूछा नहीं गया' if hi else 'Not asked') }}{% endfor %}
{% endif %}
</section>
</body>
</html>
