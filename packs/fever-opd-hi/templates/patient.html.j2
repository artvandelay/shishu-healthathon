{# Context: css, logo_uri, call_id, who, meta, emergency, incomplete, questions, yes_items,
   page2_groups, page2_unknown, page2_unasked, universal_line.
   Page one is for the patient; page two is the detail list: नहीं, पता नहीं, पूछा नहीं गया.
   Identical context contract to every pack — `intake/reports.py` renders this with no pack-specific code. #}
{%- macro detail_group(group, answer) -%}
{%- set title = group["title"] if group is mapping else group.title -%}
{%- set items = group["items"] if group is mapping else group.items -%}
  <div class="group">{{ title|e }}</div>
{% for question in items %}
  <div class="no-row"><span>{{ question|e }}</span><span class="ans">{{ answer }}</span></div>
{% endfor %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="hi">
<head><meta charset="utf-8"><title>{{ doc_title|e }}</title><meta name="description" content="{{ pdf_subject|e }}"><style>{{ css }}</style></head>
<body>
<header>
  <div class="top">
    <img src="{{ logo_uri }}" alt="">
    <div class="brand">SHISHU OPD</div>
    <div class="kind">बुखार जाँच रिपोर्ट</div>
  </div>
  <div class="rule"></div>
  <p class="who">{{ who|e }}</p>
  <p class="meta">{{ meta|e }}</p>
</header>
<div class="notice">यह कोई बीमारी की पुष्टि (डायग्नोसिस) नहीं है।<span>केवल डॉक्टर जाँच करके सही सलाह दे सकते हैं।</span></div>
{% if emergency %}
<div class="band"><b>अभी तुरंत नज़दीकी अस्पताल जाइए, या 108 पर कॉल कीजिए।</b> नीचे वही है जो इस कॉल में पूछा जा सका।</div>
{% elif incomplete %}
<div class="band"><b>यह कॉल अधूरी रही।</b> नीचे वही है जो इस कॉल में पूछा जा सका। समय मिले तो दोबारा कॉल करके बाकी सवाल पूरे कर लें।</div>
{% endif %}
{% if questions %}
<h1>डॉक्टर या स्वास्थ्य कार्यकर्ता (ASHA/ANM दीदी) से ये पूछें</h1>
<ol>
{% for question in questions %}<li>{{ question|e }}</li>
{% endfor %}</ol>
{% endif %}
<p class="note">अगर इसमें कुछ गलत है, या आप कुछ और बताना चाहते हैं, तो दोबारा कॉल कर सकते हैं।</p>
<h2>इस कॉल में जो हाँ था</h2>
{% if yes_items %}
<ul class="yes">{% for line in yes_items %}<li>{{ line|e }}</li>{% endfor %}</ul>
{% elif page2_unasked and not page2_groups and not page2_unknown %}
<p class="calm">इस कॉल में कोई जवाब दर्ज नहीं हुआ।</p>
{% else %}
<p class="calm">इस कॉल में कोई बात हाँ में नहीं आई।</p>
{% endif %}
<aside class="universal"><b>सभी के लिए एक जैसी सलाह</b><span class="why">यह किसी एक मरीज़ की जाँच के बारे में नहीं है।</span><span>{{ universal_line|e }}</span></aside>
<section class="page2">
  <h1>विवरण</h1>
  <p class="meta">{{ who|e }}</p>
{% for group in page2_groups %}{{ detail_group(group, "नहीं") }}{% endfor %}
{% if page2_unknown %}
  <div class="group">पक्का जवाब नहीं मिला</div>
{% for question in page2_unknown %}
  <div class="no-row"><span>{{ question|e }}</span><span class="ans">पता नहीं</span></div>
{% endfor %}
{% endif %}
{% if page2_unasked %}
  <div class="group">अभी नहीं पूछा गया</div>
{% for group in page2_unasked %}{{ detail_group(group, "पूछा नहीं गया") }}{% endfor %}
{% endif %}
</section>
</body>
</html>
